-- 10. INSPECTOR UI CONTROLLER
-- ══════════════════════════════════════════════════════════════════
function updateInspectorUI()
    local idx = Timeline.selectedClipIndex
    local clip = idx and Timeline.clips[idx]

    if not clip then
        inspEmptyLabel.Visible = true
        inspContent.Visible = false
        return
    end

    inspEmptyLabel.Visible = false
    inspContent.Visible = true

    inspClipName.Text = string.format("[%d] %s", idx, clip.name)
    inspDurationSummary.Text = string.format("Length: %.2fs (Orig: %.2fs)", clip.duration, clip.originalDuration)

    trimStartBox.Text = string.format("%.2f", clip.trimStart)
    trimEndBox.Text = string.format("%.2f", clip.trimEnd)

    local maxD = math.max(0.1, clip.originalDuration)
    local startPct = math.clamp(clip.trimStart / maxD, 0, 1)
    local endPct = math.clamp(clip.trimEnd / maxD, 0, 1)
    trimActiveFill.Position = UDim2.new(startPct, 0, 0, 0)
    trimActiveFill.Size = UDim2.new(math.max(0.005, endPct - startPct), 0, 1, 0)
    trimStartHandle.Position = UDim2.new(startPct, -6, 0.5, -8)
    trimEndHandle.Position = UDim2.new(endPct, -6, 0.5, -8)

    -- Update Speed Buttons in 2 rows of 3
    for _, btn in ipairs(speedBtnsContainer:GetChildren()) do
        if btn:IsA("TextButton") then btn:Destroy() end
    end

    for i, spd in ipairs(speedOptions) do
        local col = (i - 1) % 3
        local row = math.floor((i - 1) / 3)
        local sBtn = Instance.new("TextButton")
        sBtn.Size = UDim2.new(0, 74, 0, 22)
        sBtn.Position = UDim2.new(0, col * 78, 0, row * 26)
        sBtn.BackgroundColor3 = (clip.speed == spd) and C.accent or C.bg2
        sBtn.Text = tostring(spd) .. "x"
        sBtn.TextColor3 = (clip.speed == spd) and C.white or C.text3
        applyStroke(sBtn, (clip.speed == spd) and C.glassBorder or C.border, 1, 0.5)
        sBtn.Font = Enum.Font.GothamBold
        sBtn.TextSize = 9
        sBtn.Parent = speedBtnsContainer
        applyCorner(sBtn, 4)

        sBtn.MouseButton1Click:Connect(function()
            clip.speed = spd
            updateInspectorUI()
            renderTimelineTrack()
        end)
    end

    -- Update Transition In Controls (PrestigeX Transitions)
    if idx == 1 then
        transInfoLabel.Visible = true
        transDurRow.Visible = false
        transBtnsContainer.Visible = false
    else
        transInfoLabel.Visible = false
        transDurRow.Visible = true
        transBtnsContainer.Visible = true

        clip.transition = clip.transition or {
            enabled = true,
            mode = "Smooth",
            duration = 0.22,
            easing = "smootherstep",
            adaptive = true
        }

        transDurationBox.Text = string.format("%.2fs", clip.transition.duration or 0.22)

        for _, btn in ipairs(transBtnsContainer:GetChildren()) do
            if btn:IsA("TextButton") then btn:Destroy() end
        end

        local presetPositions = {
            { x = 0, y = 0, w = 48 },     -- Cut
            { x = 52, y = 0, w = 58 },    -- Quick
            { x = 114, y = 0, w = 66 },   -- Smooth
            { x = 184, y = 0, w = 52 },   -- Flow
            { x = 0, y = 26, w = 52 },    -- Soft
        }

        for i, opt in ipairs(transitionPresetList) do
            local pos = presetPositions[i] or { x = 0, y = 0, w = 50 }
            local tBtn = Instance.new("TextButton")
            tBtn.Size = UDim2.new(0, pos.w, 0, 22)
            tBtn.Position = UDim2.new(0, pos.x, 0, pos.y)
            local isSel = (clip.transition.mode == opt.key)
            tBtn.BackgroundColor3 = isSel and Color3.fromRGB(55, 20, 48) or C.bg2
            tBtn.Text = opt.label:gsub(" %([%d%.]+s%)", "")
            tBtn.TextColor3 = isSel and C.accentSoft or C.text3
            tBtn.Font = Enum.Font.GothamBold
            tBtn.TextSize = 9
            tBtn.Parent = transBtnsContainer
            applyCorner(tBtn, 4)
            if isSel then
                applyStroke(tBtn, C.glassBorder, 1, 0.3)
            else
                applyStroke(tBtn, C.border, 1, 0.5)
            end

            tBtn.MouseButton1Click:Connect(function()
                clip.transition.mode = opt.key
                local preset = TRANSITION_PRESETS[opt.key] or TRANSITION_PRESETS.Smooth
                clip.transition.duration = preset.duration
                clip.transition.easing = preset.easing
                clip.transition.enabled = (preset.duration > 0)
                updateInspectorUI()
                renderTimelineTrack()
            end)
        end
    end
end

