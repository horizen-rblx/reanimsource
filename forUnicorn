-- Multi-Clip Merge Algorithm
local function generateMergedScript()
    recalculateTimeline()
    if #Timeline.clips == 0 then return nil, "No clips on timeline." end

    local mergedKeyframes = {}
    local currentTrackStart = 0

    for clipIdx, clip in ipairs(Timeline.clips) do
        local kfs = clip.keyframes
        if kfs and #kfs > 0 then
            -- Find frames within [trimStart, trimEnd]
            local startT = clip.trimStart
            local endT = clip.trimEnd

            for _, frame in ipairs(kfs) do
                if frame.Time >= startT and frame.Time <= endT then
                    local relativeTime = (frame.Time - startT) / clip.speed
                    local globalTime = currentTrackStart + relativeTime
                    table.insert(mergedKeyframes, {
                        Time = globalTime,
                        Data = frame.Data
                    })
                end
            end
        end
        currentTrackStart = currentTrackStart + clip.duration
    end

    if #mergedKeyframes == 0 then
        return nil, "Merged keyframe sequence is empty."
    end

    table.sort(mergedKeyframes, function(a, b) return a.Time < b.Time end)

    -- Normalize first frame to 0.000
    local firstTime = mergedKeyframes[1].Time
    if firstTime > 0.001 then
        for _, f in ipairs(mergedKeyframes) do
            f.Time = math.max(0, f.Time - firstTime)
        end
    end

    local totalFrames = #mergedKeyframes
    local totalDur = mergedKeyframes[totalFrames].Time

    -- Format to standard Reanimation return table
    local lines = {}
    table.insert(lines, "-- ══════════════════════════════════════════════════\n")
    table.insert(lines, "-- Merged Reanimation Sequence created with Zen Studio\n")
    table.insert(lines, string.format("-- Total Clips: %d | Keyframes: %d | Duration: %.3fs\n", #Timeline.clips, totalFrames, totalDur))
    table.insert(lines, "-- ══════════════════════════════════════════════════\n")
    table.insert(lines, "return {\n")
    table.insert(lines, '  ["Animation"] = {\n')

    for _, frame in ipairs(mergedKeyframes) do
        local fStr = string.format("    {Time = %.3f, Data = {\n", frame.Time)
        for boneName, cf in pairs(frame.Data) do
            local c = { cf:GetComponents() }
            local compStrs = {}
            for j = 1, 12 do
                compStrs[j] = string.format("%.6f", c[j])
            end
            fStr = fStr .. string.format('      ["%s"] = CFrame.new(%s),\n', boneName, table.concat(compStrs, ", "))
        end
        fStr = fStr .. "    }},\n"
        table.insert(lines, fStr)
    end

    table.insert(lines, "  }\n")
    table.insert(lines, "}\n")

    return table.concat(lines), mergedKeyframes, totalDur
end

