            clip.trimStart = math.clamp(pct * maxD, 0, clip.trimEnd - 0.05)
            updateInspectorUI()
            renderTimelineTrack()
        elseif isDraggingTrimEnd then
            local relX = math.clamp(input.Position.X - trimEndSlider.AbsolutePosition.X, 0, trimEndSlider.AbsoluteSize.X)
            local pct = relX / trimEndSlider.AbsoluteSize.X
            clip.trimEnd = math.clamp(pct * maxD, clip.trimStart + 0.05, clip.originalDuration)
            updateInspectorUI()
            renderTimelineTrack()
        end
    end
end)

