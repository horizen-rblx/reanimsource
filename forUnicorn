        local relX = math.clamp(input.Position.X - trimSliderTrack.AbsolutePosition.X, 0, trimSliderTrack.AbsoluteSize.X)
        local pct = relX / trimSliderTrack.AbsoluteSize.X
        local targetTime = pct * maxD
        local distStart = math.abs(targetTime - clip.trimStart)
        local distEnd = math.abs(targetTime - clip.trimEnd)
        if distStart <= distEnd then
            isDraggingTrimStart = true
            clip.trimStart = math.clamp(targetTime, 0, clip.trimEnd - 0.05)
        else
            isDraggingTrimEnd = true
            clip.trimEnd = math.clamp(targetTime, clip.trimStart + 0.05, clip.originalDuration)
        end
        updateInspectorUI()
        renderTimelineTrack()
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isDraggingTrimStart = false
        isDraggingTrimEnd = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        local idx = Timeline.selectedClipIndex
        local clip = idx and Timeline.clips[idx]
        if not clip then return end
        local maxD = math.max(0.1, clip.originalDuration)

        if isDraggingTrimStart then
            local relX = math.clamp(input.Position.X - trimSliderTrack.AbsolutePosition.X, 0, trimSliderTrack.AbsoluteSize.X)
            local pct = relX / trimSliderTrack.AbsoluteSize.X
            clip.trimStart = math.clamp(pct * maxD, 0, clip.trimEnd - 0.05)
            updateInspectorUI()
            renderTimelineTrack()
        elseif isDraggingTrimEnd then
            local relX = math.clamp(input.Position.X - trimSliderTrack.AbsolutePosition.X, 0, trimSliderTrack.AbsoluteSize.X)
            local pct = relX / trimSliderTrack.AbsoluteSize.X
            clip.trimEnd = math.clamp(pct * maxD, clip.trimStart + 0.05, clip.originalDuration)
            updateInspectorUI()
            renderTimelineTrack()
        end
    end
end)

