btnAddCatalog.MouseButton1Click:Connect(function()
    local scriptContent = generateMergedScript()
    if not scriptContent then return end

    local name = exportNameBox.Text:match("^%s*(.-)%s*$")
    local finalName = (name and name ~= "") and name or ("Merged_" .. tostring(os.time()))

    pcall(function()
        local CONFIG_FILE = "ZenReanimConfig.json"
        local cfg = { customAnims = {} }
        if isfile and isfile(CONFIG_FILE) then
            local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
            if type(data) == "table" then cfg = data end
        end
        cfg.customAnims = cfg.customAnims or {}
        table.insert(cfg.customAnims, { name = finalName, script = scriptContent })
        if writefile then
            writefile(CONFIG_FILE, HttpService:JSONEncode(cfg))
        end

        table.insert(animationCatalog, {
            name = finalName,
            path = scriptContent,
            category = "Custom",
            isCustom = true
        })
        populateMediaLibrary(libSearch.Text)
        exportStatus.Text = "Added to Zen Reanimations catalog!"
        exportStatus.TextColor3 = C.green
    end)
end)

