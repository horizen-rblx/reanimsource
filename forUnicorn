-- 4. TIMELINE SEQUENCER DATA MODEL
-- ══════════════════════════════════════════════════════════════════
local Timeline = {
    clips = {},              -- Ordered array of clip objects
    selectedClipIndex = nil, -- Index of clip currently inspected
    currentTime = 0,         -- Global scrubber time (seconds)
    totalDuration = 0,       -- Calculated total length
    isPlaying = false,
    isLooping = true,
    isHoldingPose = false,   -- Keeps avatar posed at current frame on Stepped
    fps = 30,
    pixelsPerSecond = 75,    -- Horizontal timeline zoom scale
    playbackConn = nil,
    startTime = 0,
    startOffset = 0,
}

local steppedConn = nil
local setScrubberTime = nil

local function recalculateTimeline()
    local accumulated = 0
    for _, clip in ipairs(Timeline.clips) do
        local span = math.max(0.05, clip.trimEnd - clip.trimStart)
        clip.duration = span / clip.speed
        clip.timelineStart = accumulated
        clip.timelineEnd = accumulated + clip.duration
        accumulated = accumulated + clip.duration
    end
    Timeline.totalDuration = accumulated
end

-- ══════════════════════════════════════════════════════════════════
-- 4.5 TRANSITION ENGINE (PRESTIGEX SMOOTH ANIMATION SWITCHING)
-- ══════════════════════════════════════════════════════════════════
local TRANSITION_PRESETS = {
    None   = { duration = 0.00, easing = "linear",       label = "Cut (None)" },
    Quick  = { duration = 0.12, easing = "smoothstep",   label = "Quick (0.12s)" },
    Smooth = { duration = 0.22, easing = "smootherstep", label = "Smooth (0.22s)" },
    Flow   = { duration = 0.34, easing = "sine",         label = "Flow (0.34s)" },
    Soft   = { duration = 0.48, easing = "smootherstep", label = "Soft (0.48s)" },
}

local function easeTransition(easing, t)
    t = math.clamp(tonumber(t) or 1, 0, 1)
    if easing == "sine" then
        return 0.5 - 0.5 * math.cos(math.pi * t)
    elseif easing == "smoothstep" then
        return t * t * (3 - 2 * t)
    elseif easing == "smootherstep" then
        -- Ken Perlin's quintic smootherstep polynomial (PrestigeX)
        return t * t * t * (t * (t * 6 - 15) + 10)
    end
    return t
end

-- Samples keyframe pose for a clip at a specific local keyframe time
local function sampleClipPose(clip, targetKeyTime)
    local kfs = clip and clip.keyframes
    if not kfs or #kfs == 0 then return {} end
    local count = #kfs

    local low, high = 1, count
    local curIdx = 1
    while low <= high do
        local mid = math.floor((low + high) / 2)
        if kfs[mid].Time <= targetKeyTime then
            curIdx = mid
            low = mid + 1
        else
            high = mid - 1
        end
    end

    local curFrame = kfs[curIdx]
    local nextFrame = kfs[math.min(count, curIdx + 1)] or curFrame

    local span = nextFrame.Time - curFrame.Time
    local alpha = 0
    if span > 0.0001 then
        alpha = math.clamp((targetKeyTime - curFrame.Time) / span, 0, 1)
    end

    local pose = {}
    for boneName, cf in pairs(curFrame.Data) do
        local nextPose = nextFrame.Data and nextFrame.Data[boneName]
        pose[boneName] = nextPose and cf:Lerp(nextPose, alpha) or cf
    end
    return pose
end

-- Adaptive transition duration based on rotation & translation delta between poses (PrestigeX)
local function resolveAdaptiveTransitionDuration(outgoingPose, incomingPose, baseDuration)
    baseDuration = tonumber(baseDuration) or 0.22
    if baseDuration <= 0 then return 0 end
    local maxDiff = 0
    for bone, cfA in pairs(outgoingPose or {}) do
        local cfB = incomingPose and incomingPose[bone]
        if cfA and cfB then
            local delta = cfA:ToObjectSpace(cfB)
            local okAxis, _, angle = pcall(function() return delta:ToAxisAngle() end)
            local rotScore = okAxis and math.clamp(math.abs(tonumber(angle) or 0) / math.pi, 0, 1) or 0
            local posScore = math.clamp(delta.Position.Magnitude / 2.5, 0, 1)
            maxDiff = math.max(maxDiff, rotScore, posScore)
        end
    end
    return math.clamp(baseDuration * (0.72 + maxDiff * 0.72), 0.08, 0.70)
end

-- Apply exact interpolated pose to avatar joints at time T with PrestigeX smooth transitions
local function evaluateAndPoseAvatar(globalTime)
    if #Timeline.clips == 0 or Timeline.totalDuration <= 0 then return end

    local activeChar = (api and api.get_clone and api.get_clone()) or player.Character
    if cachedJoints._target ~= activeChar or not next(cachedJoints) then
        cacheAvatarJoints()
    end
    if not next(cachedJoints) then return end

    local clampedTime = math.clamp(globalTime, 0, Timeline.totalDuration)

    -- Identify active clip index
    local activeIdx = 1
    for i, clip in ipairs(Timeline.clips) do
        if clampedTime >= clip.timelineStart and clampedTime <= clip.timelineEnd then
            activeIdx = i
            break
        end
    end

    local activeClip = Timeline.clips[activeIdx] or Timeline.clips[#Timeline.clips]
    if not (activeClip and activeClip.keyframes and #activeClip.keyframes > 0) then return end

    -- Check if we are in transition blending window between previous clip and active clip
    local targetPose = nil
    if activeIdx > 1 then
        local prevClip = Timeline.clips[activeIdx - 1]
        local tr = activeClip.transition
        local trDuration = tr and tr.enabled and tonumber(tr.duration) or 0

        if trDuration > 0 and prevClip and prevClip.keyframes and #prevClip.keyframes > 0 then
            local maxAllowed = math.min(activeClip.duration * 0.9, prevClip.duration * 0.9)
            local baseDur = math.min(trDuration, maxAllowed)
            local elapsedInClip = clampedTime - activeClip.timelineStart

            if elapsedInClip >= 0 and elapsedInClip < baseDur then
                -- Sample outgoing pose at end of previous clip
                local outgoingPose = sampleClipPose(prevClip, prevClip.trimEnd)
                -- Sample incoming pose at current time in active clip
                local localElapsed = elapsedInClip * activeClip.speed
                local incomingKeyTime = activeClip.trimStart + localElapsed
                local incomingPose = sampleClipPose(activeClip, incomingKeyTime)

                local effDuration = baseDur
                if tr.adaptive ~= false then
                    effDuration = math.min(resolveAdaptiveTransitionDuration(outgoingPose, incomingPose, baseDur), maxAllowed)
                end

                local progress = math.clamp(elapsedInClip / math.max(effDuration, 0.001), 0, 1)
                local blendAlpha = easeTransition(tr.easing or "smootherstep", progress)

                targetPose = {}
                for bone, inCf in pairs(incomingPose) do
                    local outCf = outgoingPose[bone]
                    targetPose[bone] = outCf and outCf:Lerp(inCf, blendAlpha) or inCf
                end
                for bone, outCf in pairs(outgoingPose) do
                    if not targetPose[bone] then
                        targetPose[bone] = outCf
                    end
                end
            end
        end
    end

    -- If not in transition window, evaluate active clip directly
    if not targetPose then
        local localElapsed = (clampedTime - activeClip.timelineStart) * activeClip.speed
        local targetKeyTime = activeClip.trimStart + localElapsed
        targetPose = sampleClipPose(activeClip, targetKeyTime)
    end

    -- Apply poses to avatar joints
    for boneName, poseCFrame in pairs(targetPose) do
        local joint = cachedJoints[boneName] or cachedJoints[boneName:gsub(" ", "")] or cachedJoints[boneName:lower()]
        if joint then
            joint.Transform = poseCFrame
        end
    end
end

