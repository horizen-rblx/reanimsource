local function setScrubberTime(targetTime)
    recalculateTimeline()
    local clamped = math.clamp(targetTime, 0, math.max(0.1, Timeline.totalDuration))
    Timeline.currentTime = clamped
    timecodeLabel.Text = formatTime(clamped)
    playheadTimeBubble.Text = string.format("%04.1fs", clamped)

    local posX = clamped * Timeline.pixelsPerSecond
    playhead.Position = UDim2.new(0, posX, 0, 0)

    evaluateAndPoseAvatar(clamped)
end

-- Scrubbing Interaction
local isScrubbing = false
local function handleScrubInput(input)
    local relX = input.Position.X - trackLane.AbsolutePosition.X
    local scrolledX = relX + timelineScroll.CanvasPosition.X
    local targetSecs = math.max(0, scrolledX / Timeline.pixelsPerSecond)
    setScrubberTime(targetSecs)
end

timelineScroll.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isScrubbing = true
        handleScrubInput(input)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isScrubbing = false
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if isScrubbing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        handleScrubInput(input)
    end
end)

-- Transport Playback Loop
local function stopPlayback()
    if not Timeline.isPlaying then return end
    Timeline.isPlaying = false
    if Timeline.playbackConn then
        Timeline.playbackConn:Disconnect()
        Timeline.playbackConn = nil
    end
    btnPlay.Text = "▶ PLAY"
    btnPlay.TextColor3 = C.green
    btnPlay.BackgroundColor3 = Color3.fromRGB(30, 60, 40)
end

local function startPlayback()
    if Timeline.isPlaying then return end
    if #Timeline.clips == 0 or Timeline.totalDuration <= 0 then return end

    Timeline.isPlaying = true
    Timeline.startTime = tick()
    Timeline.startOffset = Timeline.currentTime

    if Timeline.currentTime >= Timeline.totalDuration - 0.05 then
        Timeline.currentTime = 0
        Timeline.startOffset = 0
    end

    btnPlay.Text = "⏸ PAUSE"
    btnPlay.TextColor3 = Color3.fromRGB(255, 200, 80)
    btnPlay.BackgroundColor3 = Color3.fromRGB(60, 45, 20)

    Timeline.playbackConn = RunService.Heartbeat:Connect(function()
        if not Timeline.isPlaying then return end
        local elapsed = tick() - Timeline.startTime
        local newTime = Timeline.startOffset + elapsed

        if newTime >= Timeline.totalDuration then
            if Timeline.isLooping then
                Timeline.startTime = tick()
                Timeline.startOffset = 0
                newTime = 0
            else
                stopPlayback()
                setScrubberTime(Timeline.totalDuration)
                return
            end
        end

        setScrubberTime(newTime)
    end)
end

btnPlay.MouseButton1Click:Connect(function()
    if Timeline.isPlaying then
        stopPlayback()
    else
        startPlayback()
    end
end)

btnStop.MouseButton1Click:Connect(function()
    stopPlayback()
    setScrubberTime(0)
end)

btnRewind.MouseButton1Click:Connect(function()
    setScrubberTime(0)
end)

btnStepBack.MouseButton1Click:Connect(function()
    setScrubberTime(Timeline.currentTime - (1 / Timeline.fps))
end)

btnStepFwd.MouseButton1Click:Connect(function()
    setScrubberTime(Timeline.currentTime + (1 / Timeline.fps))
end)

btnLoop.MouseButton1Click:Connect(function()
