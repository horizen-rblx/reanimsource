-- Resolve joints in avatar (clone or character)
local cachedJoints = {}
local function cacheAvatarJoints()
    table.clear(cachedJoints)
    local targetChar = (api and api.get_clone and api.get_clone()) or player.Character
    if not targetChar then return end

    for _, desc in ipairs(targetChar:GetDescendants()) do
        if desc:IsA("Motor6D") or desc:IsA("Weld") or desc:IsA("JointInstance") then
            if desc.Part1 then
                cachedJoints[desc.Part1.Name] = desc
            else
                cachedJoints[desc.Name] = desc
            end
        elseif desc:IsA("AnimationConstraint") or desc:IsA("Bone") then
            if desc.Part1 then
                cachedJoints[desc.Part1.Name] = desc
            else
                cachedJoints[desc.Name] = desc
            end
        end
    end
end

