-- Resolve joints in avatar (clone or character)
local cachedJoints = {}

local function prepareTargetChar(targetChar)
    if not targetChar then return end
    local hum = targetChar:FindFirstChildOfClass("Humanoid") or targetChar:FindFirstChildOfClass("AnimationController")
    if hum then
        pcall(function()
            for _, track in ipairs(hum:GetPlayingAnimationTracks()) do
                track:Stop()
            end
        end)
    end
    local animScript = targetChar:FindFirstChild("Animate")
    if animScript then
        animScript.Disabled = true
    end
end

local function cacheAvatarJoints()
    table.clear(cachedJoints)
    local targetChar = (api and api.get_clone and api.get_clone()) or player.Character
    if not targetChar then return end

    cachedJoints._target = targetChar
    prepareTargetChar(targetChar)

    for _, desc in ipairs(targetChar:GetDescendants()) do
        if desc:IsA("JointInstance") then
            if desc.Part1 then
                cachedJoints[desc.Part1.Name] = desc
                cachedJoints[desc.Part1.Name:lower()] = desc
                cachedJoints[desc.Part1.Name:gsub(" ", "")] = desc
            end
            cachedJoints[desc.Name] = desc
            cachedJoints[desc.Name:lower()] = desc
            cachedJoints[desc.Name:gsub(" ", "")] = desc
        elseif desc:IsA("Bone") then
            cachedJoints[desc.Name] = desc
            cachedJoints[desc.Name:lower()] = desc
        elseif desc:IsA("AnimationConstraint") then
            if desc.Part1 then
                cachedJoints[desc.Part1.Name] = desc
                cachedJoints[desc.Part1.Name:lower()] = desc
            end
            cachedJoints[desc.Name] = desc
            cachedJoints[desc.Name:lower()] = desc
        end
    end
end

