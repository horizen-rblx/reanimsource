                    if kfs and #kfs > 0 then
                        local origDur = kfs[#kfs].Time
                        local colorIdx = ((#Timeline.clips) % #CLIP_COLORS) + 1
                        local clip = {
                            id = "clip_" .. tostring(tick()),
                            name = item.name,
                            path = item.path,
