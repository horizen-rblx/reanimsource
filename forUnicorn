-- 9. RENDER TIMELINE TRACKS & RULER
-- ══════════════════════════════════════════════════════════════════
function renderTimelineTrack()
    recalculateTimeline()

    for _, c in ipairs(clipsContainer:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextButton") then c:Destroy() end
    end

    for _, c in ipairs(rulerTicksFrame:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end
    end

    local totalWidth = math.max(800, (Timeline.totalDuration + 4) * Timeline.pixelsPerSecond)
    timelineScroll.CanvasSize = UDim2.new(0, totalWidth, 0, 0)
    emptyTrackLabel.Visible = (#Timeline.clips == 0)

    -- Draw Ruler Markings every 0.5s and 1.0s
    local numSeconds = math.ceil(totalWidth / Timeline.pixelsPerSecond)
    for s = 0, numSeconds do
        local posX = s * Timeline.pixelsPerSecond

        local tickLine = Instance.new("Frame")
        tickLine.Size = UDim2.new(0, 1, 0, 10)
        tickLine.Position = UDim2.new(0, posX, 1, -10)
        tickLine.BackgroundColor3 = C.divider
        tickLine.BorderSizePixel = 0
        tickLine.Parent = rulerTicksFrame

        local tickLabel = Instance.new("TextLabel")
        tickLabel.Size = UDim2.new(0, 36, 0, 12)
        tickLabel.Position = UDim2.new(0, posX - 18, 0, 4)
        tickLabel.BackgroundTransparency = 1
        tickLabel.Text = string.format("%d.0s", s)
        tickLabel.TextColor3 = C.textMuted
        tickLabel.Font = Enum.Font.Code
        tickLabel.TextSize = 8
        tickLabel.Parent = rulerTicksFrame

        -- Half second tick
        local halfTick = Instance.new("Frame")
        halfTick.Size = UDim2.new(0, 1, 0, 5)
        halfTick.Position = UDim2.new(0, posX + (Timeline.pixelsPerSecond / 2), 1, -5)
        halfTick.BackgroundColor3 = C.divider
        halfTick.BorderSizePixel = 0
        halfTick.Parent = rulerTicksFrame
    end

    -- Draw Visual Clips
    for idx, clip in ipairs(Timeline.clips) do
        local posX = clip.timelineStart * Timeline.pixelsPerSecond
        local clipW = math.max(24, clip.duration * Timeline.pixelsPerSecond)
        local isSelected = (Timeline.selectedClipIndex == idx)

        local clipCard = Instance.new("TextButton")
        clipCard.Size = UDim2.new(0, clipW - 2, 1, -8)
        clipCard.Position = UDim2.new(0, posX + 1, 0, 4)
        clipCard.BackgroundColor3 = clip.color
        clipCard.Text = ""
        clipCard.AutoButtonColor = false
        clipCard.Parent = clipsContainer
        applyCorner(clipCard, 6)

        local cardStroke = applyStroke(clipCard, isSelected and C.accent or Color3.fromRGB(0, 0, 0), isSelected and 2 or 1, isSelected and 0 or 0.6)

        -- Top color accent banner
        local topBanner = Instance.new("Frame")
        topBanner.Size = UDim2.new(1, 0, 0, 4)
        topBanner.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        topBanner.BackgroundTransparency = isSelected and 0.2 or 0.7
        topBanner.BorderSizePixel = 0
        topBanner.Parent = clipCard
        applyCorner(topBanner, 2)

        -- Title & Timing inside Clip
        local clipTitle = Instance.new("TextLabel")
        clipTitle.Size = UDim2.new(1, -10, 0, 16)
        clipTitle.Position = UDim2.new(0, 6, 0, 8)
        clipTitle.BackgroundTransparency = 1
        clipTitle.Text = clip.name
        clipTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
        clipTitle.Font = Enum.Font.GothamBold
        clipTitle.TextSize = 10
        clipTitle.TextXAlignment = Enum.TextXAlignment.Left
        clipTitle.TextTruncate = Enum.TextTruncate.AtEnd
        clipTitle.Parent = clipCard

        local clipSub = Instance.new("TextLabel")
        clipSub.Size = UDim2.new(1, -10, 0, 14)
        clipSub.Position = UDim2.new(0, 6, 0, 26)
        clipSub.BackgroundTransparency = 1
        clipSub.Text = string.format("%.2fs  [%.1f-%.1fs]", clip.duration, clip.trimStart, clip.trimEnd)
        clipSub.TextColor3 = Color3.fromRGB(220, 220, 230)
        clipSub.Font = Enum.Font.GothamMedium
        clipSub.TextSize = 9
        clipSub.TextXAlignment = Enum.TextXAlignment.Left
        clipSub.TextTruncate = Enum.TextTruncate.AtEnd
        clipSub.Parent = clipCard

        -- Transition overlay and seam badge for idx > 1 (PrestigeX smooth transitions)
        if idx > 1 then
            local tr = clip.transition
            local trDur = tr and tr.enabled and tonumber(tr.duration) or 0
            if trDur > 0 then
                local transZoneW = math.clamp(trDur * Timeline.pixelsPerSecond, 6, clipW * 0.8)
                local transOverlay = Instance.new("Frame")
                transOverlay.Size = UDim2.new(0, transZoneW, 1, 0)
                transOverlay.Position = UDim2.new(0, 0, 0, 0)
                transOverlay.BackgroundColor3 = C.glassBorder
                transOverlay.BackgroundTransparency = 0.85
                transOverlay.BorderSizePixel = 0
                transOverlay.Parent = clipCard
                applyCorner(transOverlay, 5)

                -- Transition seam indicator (sleek badge only)

                local transBadge = Instance.new("TextButton")
                transBadge.Size = UDim2.new(0, 46, 0, 16)
                transBadge.Position = UDim2.new(0, posX - 23, 0, 2)
                transBadge.BackgroundColor3 = C.bg2
                transBadge.Text = string.format("%.2fs", trDur)
                transBadge.TextColor3 = C.accentSoft
                transBadge.Font = Enum.Font.Code
                transBadge.TextSize = 8
                transBadge.ZIndex = 25
                transBadge.Parent = clipsContainer
                applyCorner(transBadge, 8)
                applyStroke(transBadge, C.glassBorder, 1, 0.4)

                transBadge.MouseButton1Click:Connect(function()
                    Timeline.selectedClipIndex = idx
                    updateInspectorUI()
                    renderTimelineTrack()
                end)
            end
        end

        -- Select Clip Action
        clipCard.MouseButton1Click:Connect(function()
            Timeline.selectedClipIndex = idx
            updateInspectorUI()
            renderTimelineTrack()
        end)
    end

    setScrubberTime(Timeline.currentTime)
end

