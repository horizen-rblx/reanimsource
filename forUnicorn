        Timeline.totalDuration,
        Timeline.clips[1].name .. (#Timeline.clips > 1 and (" + " .. tostring(#Timeline.clips - 1) .. " more") or "")
    )
    exportStatus.Text = "Ready to export."
    exportStatus.TextColor3 = C.textMuted
end)

btnCopyClipboard.MouseButton1Click:Connect(function()
    local scriptContent, _, dur = generateMergedScript()
    if not scriptContent then
        exportStatus.Text = "Export failed: " .. tostring(dur)
        exportStatus.TextColor3 = C.danger
        return
    end

    pcall(function()
        if setclipboard then
            setclipboard(scriptContent)
            exportStatus.Text = "Merged script copied to clipboard!"
            exportStatus.TextColor3 = C.green
        else
            exportStatus.Text = "Clipboard not supported on this executor."
            exportStatus.TextColor3 = C.danger
        end
    end)
end)

btnSaveDisk.MouseButton1Click:Connect(function()
    local scriptContent = generateMergedScript()
    if not scriptContent then return end

    local name = exportNameBox.Text:match("^%s*(.-)%s*$")
    local finalName = (name and name ~= "") and name or ("Merged_" .. tostring(os.time()))

    pcall(function()
        if makefolder then
            makefolder("ZenReanim")
            makefolder("ZenReanim/Merged")
        end
        if writefile then
            writefile("ZenReanim/Merged/" .. finalName .. ".lua", scriptContent)
            exportStatus.Text = "Saved to ZenReanim/Merged/" .. finalName .. ".lua"
            exportStatus.TextColor3 = C.green
        else
            exportStatus.Text = "File writing not supported on this executor."
            exportStatus.TextColor3 = C.danger
        end
    end)
end)

